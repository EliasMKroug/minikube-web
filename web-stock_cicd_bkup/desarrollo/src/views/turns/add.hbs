<div class="container p-4">
    <h2 class="text-center">Reservar Fecha</h2>
    <div class="d-flex justify-content-end mb-3">
        <a href="/turns" class="btn btn-primary">Turnos</a>
    </div> 
    <div class="row">
        <div class="col-md-4 mx-auto">
            <div class="card">
                <div class="card-body ">
                    <form action="/turns/add" method="POST">
                        <div class="form-group p-1">
                            <h3 class="text-center">Agregar un Turno</h3>
                        </div>

                        {{#if messages.error}}
                            <div class="alert alert-danger">{{messages.error}}</div>
                        {{/if}}

                        <div class="form-group p-2">
                            <input type="text" name="client_name" class="form-control" placeholder="Nombre" autofocus required>
                        </div>
                        <div class="form-group p-2">
                            <input type="email" name="email" class="form-control" placeholder="Email" required>
                        </div>
                        <div class="form-group p-2">
                            <input type="tel" name="phone" class="form-control" placeholder="Teléfono" required>
                        </div>               
                        <div class="form-group p-2">
                            <input type="text" name="employee" class="form-control" placeholder="Barbero" required>
                        </div>
                        <div class="form-group p-2">
                            <label for="date">Fecha:</label>
                            <input type="date" name="fecha" id="date" class="form-control" required>    
                        </div>
                        <div class="form-group p-2">
                            <label for="hora">Hora:</label>
                            <select name="hora" id="hora" class="form-control" required>
                                {{#each horarios}}
                                    <option value="{{this}}">{{this}}</option>
                                {{/each}}
                            </select>
                        </div>
                        <div class="form-group p-2 d-grid gap-1">
                            <button class="btn btn-success btn-block">Guardar</button>
                            <a href="/turns" class="btn btn-secondary">Cancelar</a>
                        </div>                        
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>