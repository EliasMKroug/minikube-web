 {{!-- ESTE FORMULARIO ES PARA EDITAR CAMPOS EN LA DB --}}
<div class="container p-4"> 
    <div class="row">
        <div class="col-md-4 mx-auto">
            <div class="card">
                <div class="card-body ">
                    <form action="/products/edit/{{products.id}}" method="POST">
                        <div class="form-group p-1">
                            <h3 class="text-center">Editar un Producto</h3>
                        </div>
                        <div class="form-group p-2">
                            <input type="text" name="product" class="form-control" placeholder="Nombre" value="{{products.product}}" >
                        </div>
                        <div class="form-group p-2">
                            <input type="text" name="type" class="form-control" placeholder="type" value="{{products.type}}">
                        </div>
                        <div class="form-group p-2">
                            <input name="description" rows="3" class="form-control" placeholder="Descripcion" value="{{products.description}}" ></input>
                        </div>               
                        <div class="form-group p-2">
                            <input type="int" name="stock" class="form-control" placeholder="Stock" value="{{products.stock}}" autofocus>
                        </div>
                        <div class="form-group p-2">
                            <input type="int" name="price" class="form-control" placeholder="Price" value="{{products.price}}">
                        </div>
                        <div class="form-group p-2">
                            <input type="int" name="cost" class="form-control" placeholder="Cost" value="{{products.cost}}">
                        </div>
                        <div class="form-group p-2 d-grid gap-1">
                            {{!-- <button class="btn btn-success btn-block">
                                Save
                            </button>   --}}
                            <button type="submit" class="btn btn-success btn-block">Actualizar Producto</button>
                            <a href="/products" class="btn btn-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>